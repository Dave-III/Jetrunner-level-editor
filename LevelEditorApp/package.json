{
  "name": "jetrunner-level-editor",
  "version": "1.0.3",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc && vite build && node scripts/prune-release-assets.mjs",
    "start": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis --publish never",
    "package:win:dir": "npm run build && electron-builder --win dir",
    "release:github": "npm run build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "electron-updater": "^6.8.9",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "nz.jetrunner.level-editor",
    "productName": "JETRUNNER Level Editor",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/new-object-catalog.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/juan.png",
        "to": "juan.png"
      },
      {
        "from": "build/splash",
        "to": "splash",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../UAssetPipeline",
        "to": "UAssetPipeline",
        "filter": [
          "Build-JLELevel.ps1",
          "Templates/**/*",
          "Scripts/Generate-JLEProject.cjs",
          "Scripts/new-object-catalog.json",
          "Resources/**/*",
          "Framework/CustomLevelsV0.9.2.pak",
          "Tools/UAssetGUI/**/*",
          "Tools/repak/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/juan.png",
      "artifactName": "JETRUNNER-Level-Editor-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JETRUNNER Level Editor",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Dave-III",
        "repo": "Jetrunner-level-editor",
        "releaseType": "release"
      }
    ],
    "fileAssociations": [
      {
        "ext": "jle",
        "name": "JETRUNNER Custom Level",
        "description": "Shareable JETRUNNER custom level",
        "role": "Editor"
      }
    ]
  }
}
